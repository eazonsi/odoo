<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="qlx_hr_employee_form" model="ir.ui.view">
        <field name="name">qlx.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page/div/div/group[1]" position="inside">
                <group string="Work Period">
                    <field name="start_date"/>
                    <field name="trial_period"/>
                    <field name="trial_end_date" readonly="1"/>
                    <field name="end_date"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="qlx_hr_employee_resume_line_form" model="ir.ui.view">
        <field name="name">hr.resume.line.form</field>
        <field name="model">hr.resume.line</field>
        <field name="inherit_id" ref="hr_skills.resume_line_view_form"/>
        <field name="arch" type="xml">
                    <field name="line_type_id" position="after">
                        <field name="establishment"/>
                    </field>
        </field>
    </record>

    </data>
</odoo>